// AetherOS design system (P4, S3).
//
// Implements design D1 (UI design): dark glass tokens, the 4 px grid, the
// 28 px menu bar, 64 px dock, 340 px control center, 360 px notifications and
// the 640 px launcher. Every widget is original geometry — no copied assets.
//
// Conventions used by the shell and the default apps:
//  * All interactive widgets set `accessible-label`, so headless element-query
//    tests can find a *specific* instance (element ids repeat per definition).
//  * Sizes are multiples of 4 px via `Tokens.space(n)`.
//  * Panels use `GlassPanel`, which degrades from full to reduced to minimal
//    glass per the tier (D1 section 4); the compositor supplies the blur.

export enum GlassTier {
    full,
    reduced,
    minimal,
}

export enum IconKind {
    menu,
    apps,
    search,
    close,
    plus,
    minus,
    check,
    chevron-left,
    chevron-right,
    chevron-up,
    chevron-down,
    wifi,
    wifi-off,
    bluetooth,
    bluetooth-off,
    volume,
    volume-muted,
    brightness,
    battery,
    bolt,
    bell,
    bell-off,
    moon,
    sun,
    gear,
    folder,
    file,
    image,
    document,
    terminal,
    calendar,
    clock,
    play,
    pause,
    skip-forward,
    skip-back,
    lock,
    user,
    power,
    trash,
    download,
    star,
    history,
    refresh,
    display,
    keyboard,
    shield,
    info,
    calculator,
    archive,
    globe,
    activity,
    mouse,
}

export global Tokens {
    // D1 section 5, dark theme defaults (overridable from
    // ~/.config/aether/theme/tokens.toml once F4 lands).
    out property <color> background: #0E1116;
    out property <color> background-alt: #0A0D12;
    out property <color> surface: #1A1F27;
    out property <color> surface-high: #232A34;
    out property <color> surface-low: #141920;
    out property <color> text: #F2F4F7;
    out property <color> text-muted: #9AA4B2;
    out property <color> text-faint: #6B7684;
    out property <color> accent: #4C8DFF;
    out property <color> accent-soft: #4C8DFF33;
    out property <color> accent-strong: #6BA1FF;
    out property <color> danger: #FF5C5C;
    out property <color> success: #3DD68C;
    out property <color> warning: #F5A524;
    out property <color> on-accent: #07101F;

    out property <color> glass-tint-dark: #0E111699;
    out property <color> glass-tint-light: #FFFFFF2E;
    out property <color> glass-edge: #FFFFFF66;
    out property <color> glass-edge-soft: #FFFFFF33;
    out property <color> glass-edge-minimal: #FFFFFF33;
    out property <color> divider: #FFFFFF14;
    out property <color> hover: #FFFFFF12;
    out property <color> pressed: #FFFFFF1F;
    out property <color> scrim: #05070ACC;

    out property <length> radius-panel: 18px;
    out property <length> radius-menu: 12px;
    out property <length> radius-button: 8px;
    out property <length> radius-pill: 999px;

    out property <length> menubar-height: 28px;
    out property <length> dock-height: 64px;
    out property <length> titlebar-height: 38px;
    out property <length> controlcenter-width: 340px;
    out property <length> notification-width: 360px;
    out property <length> launcher-width: 640px;

    out property <length> font-body: 13px;
    out property <length> font-small: 11px;
    out property <length> font-title: 15px;
    out property <length> font-large: 20px;
    out property <length> font-hero: 28px;
    out property <string> font-family: "Inter";
    out property <string> font-family-mono: "JetBrains Mono";

    out property <duration> motion-fast: 120ms;
    out property <duration> motion-base: 180ms;

    // 4 px grid (D1 section 3).
    public pure function space(n: int) -> length {
        return n * 4px;
    }

    public pure function tier-opacity(tier: GlassTier) -> float {
        if (tier == GlassTier.full) { return 0.72; }
        if (tier == GlassTier.reduced) { return 0.86; }
        return 0.96;
    }
}

// Original 24x24 line icons. `commands` returns SVG path data; the Icon
// component scales it into any box.
export global Icons {
    public pure function commands(kind: IconKind) -> string {
        if (kind == IconKind.menu) { return "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17"; }
        if (kind == IconKind.apps) { return "M5 5 L5 5.01 M12 5 L12 5.01 M19 5 L19 5.01 M5 12 L5 12.01 M12 12 L12 12.01 M19 12 L19 12.01 M5 19 L5 19.01 M12 19 L12 19.01 M19 19 L19 19.01"; }
        if (kind == IconKind.search) { return "M10.5 4 A6.5 6.5 0 1 1 10.49 4 Z M15.5 15.5 L20 20"; }
        if (kind == IconKind.close) { return "M6 6 L18 18 M18 6 L6 18"; }
        if (kind == IconKind.plus) { return "M12 5 L12 19 M5 12 L19 12"; }
        if (kind == IconKind.minus) { return "M5 12 L19 12"; }
        if (kind == IconKind.check) { return "M5 12.5 L9.5 17 L19 7"; }
        if (kind == IconKind.chevron-left) { return "M14.5 5.5 L8 12 L14.5 18.5"; }
        if (kind == IconKind.chevron-right) { return "M9.5 5.5 L16 12 L9.5 18.5"; }
        if (kind == IconKind.chevron-up) { return "M5.5 14.5 L12 8 L18.5 14.5"; }
        if (kind == IconKind.chevron-down) { return "M5.5 9.5 L12 16 L18.5 9.5"; }
        if (kind == IconKind.wifi) { return "M3.5 9 A13 13 0 0 1 20.5 9 M6.5 12.5 A8.5 8.5 0 0 1 17.5 12.5 M9.5 16 A4.5 4.5 0 0 1 14.5 16 M12 19 L12 19.01"; }
        if (kind == IconKind.wifi-off) { return "M3.5 9 A13 13 0 0 1 10 6.1 M14 6.3 A13 13 0 0 1 20.5 9 M6.5 12.5 A8.5 8.5 0 0 1 10.6 10.6 M13.5 10.7 A8.5 8.5 0 0 1 17.5 12.5 M9.5 16 A4.5 4.5 0 0 1 13.4 15.5 M12 19 L12 19.01 M3 3 L21 21"; }
        if (kind == IconKind.bluetooth) { return "M8 7 L16 17 L12 20 L12 4 L16 7 L8 17"; }
        if (kind == IconKind.bluetooth-off) { return "M8 7 L16 17 L12 20 L12 4 L16 7 L8 17 M3 3 L21 21"; }
        if (kind == IconKind.volume) { return "M4 9.5 L8 9.5 L12.5 5.5 L12.5 18.5 L8 14.5 L4 14.5 Z M16 9 A4.5 4.5 0 0 1 16 15 M18.5 6.5 A8 8 0 0 1 18.5 17.5"; }
        if (kind == IconKind.volume-muted) { return "M4 9.5 L8 9.5 L12.5 5.5 L12.5 18.5 L8 14.5 L4 14.5 Z M16.5 9.5 L21 14 M21 9.5 L16.5 14"; }
        if (kind == IconKind.brightness) { return "M12 7.5 A4.5 4.5 0 1 1 11.99 7.5 Z M12 2.5 L12 4.5 M12 19.5 L12 21.5 M2.5 12 L4.5 12 M19.5 12 L21.5 12 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M18.7 5.3 L17.3 6.7 M6.7 17.3 L5.3 18.7"; }
        if (kind == IconKind.battery) { return "M3 8 L17 8 L17 16 L3 16 Z M19 10.5 L19 13.5 M5.5 10.5 L13.5 10.5 L13.5 13.5 L5.5 13.5 Z"; }
        if (kind == IconKind.bolt) { return "M13.5 3 L6.5 13.5 L11.5 13.5 L10.5 21 L17.5 10.5 L12.5 10.5 Z"; }
        if (kind == IconKind.bell) { return "M6 16.5 L7.5 14.5 L7.5 10 A4.5 4.5 0 0 1 16.5 10 L16.5 14.5 L18 16.5 Z M10 19.5 A2 2 0 0 0 14 19.5 M12 3 L12 5.5"; }
        if (kind == IconKind.bell-off) { return "M6 16.5 L7.5 14.5 L7.5 10 A4.5 4.5 0 0 1 14.2 6.6 M16.5 10 L16.5 14.5 L18 16.5 L6 16.5 M10 19.5 A2 2 0 0 0 14 19.5 M3 3 L21 21"; }
        if (kind == IconKind.moon) { return "M20 14.5 A8.5 8.5 0 1 1 9.5 4 A7 7 0 0 0 20 14.5 Z"; }
        if (kind == IconKind.sun) { return "M12 8 A4 4 0 1 1 11.99 8 Z M12 3 L12 5 M12 19 L12 21 M3 12 L5 12 M19 12 L21 12 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M18.4 5.6 L17 7 M7 17 L5.6 18.4"; }
        if (kind == IconKind.gear) { return "M12 9 A3 3 0 1 1 11.99 9 Z M12 2.5 L13.2 5.2 L16.1 4.6 L16.6 7.5 L19.3 8.7 L17.8 11.2 L19.3 13.8 L16.6 15 L16.1 17.9 L13.2 17.3 L12 20 L10.8 17.3 L7.9 17.9 L7.4 15 L4.7 13.8 L6.2 11.2 L4.7 8.7 L7.4 7.5 L7.9 4.6 L10.8 5.2 Z"; }
        if (kind == IconKind.folder) { return "M3.5 6.5 L10 6.5 L12 8.5 L20.5 8.5 L20.5 18 L3.5 18 Z"; }
        if (kind == IconKind.file) { return "M6 3.5 L14 3.5 L18.5 8 L18.5 20.5 L6 20.5 Z M14 3.5 L14 8 L18.5 8"; }
        if (kind == IconKind.image) { return "M3.5 5 L20.5 5 L20.5 19 L3.5 19 Z M3.5 15.5 L8.5 11 L12.5 15 L15.5 12.5 L20.5 17 M9.5 8.5 L9.5 8.51"; }
        if (kind == IconKind.document) { return "M6 3.5 L14 3.5 L18.5 8 L18.5 20.5 L6 20.5 Z M14 3.5 L14 8 L18.5 8 M9 12 L15.5 12 M9 15 L15.5 15 M9 17.5 L13 17.5"; }
        if (kind == IconKind.terminal) { return "M3.5 5 L20.5 5 L20.5 19 L3.5 19 Z M7 9.5 L10 12.5 L7 15.5 M12.5 15.5 L17 15.5"; }
        if (kind == IconKind.calendar) { return "M3.5 6.5 L20.5 6.5 L20.5 20 L3.5 20 Z M3.5 10.5 L20.5 10.5 M8 4 L8 8 M16 4 L16 8"; }
        if (kind == IconKind.clock) { return "M12 4 A8 8 0 1 1 11.99 4 Z M12 7.5 L12 12.5 L15.5 14.5"; }
        if (kind == IconKind.play) { return "M7.5 4.5 L19 12 L7.5 19.5 Z"; }
        if (kind == IconKind.pause) { return "M8 5 L10.5 5 L10.5 19 L8 19 Z M13.5 5 L16 5 L16 19 L13.5 19 Z"; }
        if (kind == IconKind.skip-forward) { return "M6 5.5 L15 12 L6 18.5 Z M17.5 5.5 L17.5 18.5"; }
        if (kind == IconKind.skip-back) { return "M18 5.5 L9 12 L18 18.5 Z M6.5 5.5 L6.5 18.5"; }
        if (kind == IconKind.lock) { return "M6.5 10.5 L17.5 10.5 L17.5 20 L6.5 20 Z M8.5 10.5 L8.5 7.5 A3.5 3.5 0 0 1 15.5 7.5 L15.5 10.5 M12 14 L12 16.5"; }
        if (kind == IconKind.user) { return "M12 11 A3.75 3.75 0 1 1 11.99 11 Z M4.5 20.5 A7.5 7.5 0 0 1 19.5 20.5"; }
        if (kind == IconKind.power) { return "M12 3.5 L12 11 M7 6 A7.5 7.5 0 1 0 17 6"; }
        if (kind == IconKind.trash) { return "M4.5 7 L19.5 7 M9.5 7 L9.5 4.5 L14.5 4.5 L14.5 7 M6.5 7 L7.5 20 L16.5 20 L17.5 7 M10 10.5 L10 16.5 M14 10.5 L14 16.5"; }
        if (kind == IconKind.download) { return "M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M4.5 19.5 L19.5 19.5"; }
        if (kind == IconKind.star) { return "M12 4 L14.2 9.4 L20 10 L15.6 13.9 L16.9 19.6 L12 16.7 L7.1 19.6 L8.4 13.9 L4 10 L9.8 9.4 Z"; }
        if (kind == IconKind.history) { return "M4.5 12 A7.5 7.5 0 1 0 7 6.3 M4.5 5 L4.5 9.5 L9 9.5 M12 8 L12 12.5 L15.5 14.5"; }
        if (kind == IconKind.refresh) { return "M19.5 12 A7.5 7.5 0 1 1 17 6.4 M19.5 4.5 L19.5 9 L15 9"; }
        if (kind == IconKind.display) { return "M3 5 L21 5 L21 17 L3 17 Z M9 20.5 L15 20.5 M12 17 L12 20.5"; }
        if (kind == IconKind.keyboard) { return "M3 7 L21 7 L21 17 L3 17 Z M6.5 10.5 L6.5 10.51 M10 10.5 L10 10.51 M13.5 10.5 L13.5 10.51 M17 10.5 L17 10.51 M7.5 14 L16.5 14"; }
        if (kind == IconKind.shield) { return "M12 3.5 L19.5 6 L19.5 12 A7.5 7.5 0 0 1 12 20.5 A7.5 7.5 0 0 1 4.5 12 L4.5 6 Z M9 12 L11.2 14.2 L15.5 9.8"; }
        if (kind == IconKind.info) { return "M12 4 A8 8 0 1 1 11.99 4 Z M12 10.5 L12 16.5 M12 7.5 L12 7.51"; }
        if (kind == IconKind.calculator) { return "M5.5 3.5 L18.5 3.5 L18.5 20.5 L5.5 20.5 Z M8.5 7 L15.5 7 L15.5 10 L8.5 10 Z M8.5 13 L8.5 13.01 M12 13 L12 13.01 M15.5 13 L15.5 13.01 M8.5 16.5 L8.5 16.51 M12 16.5 L12 16.51 M15.5 16.5 L15.5 16.51"; }
        if (kind == IconKind.archive) { return "M3.5 4.5 L20.5 4.5 L20.5 8 L3.5 8 Z M5 8 L5 20 L19 20 L19 8 M10 11.5 L14 11.5"; }
        if (kind == IconKind.globe) { return "M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M3.5 12 L20.5 12 M12 3.5 A12 12 0 0 1 12 20.5 A12 12 0 0 1 12 3.5 Z"; }
        if (kind == IconKind.activity) { return "M3 12.5 L7 12.5 L9.5 6 L13 18 L15.5 12.5 L21 12.5"; }
        if (kind == IconKind.mouse) { return "M8 3.5 L16 3.5 A4 4 0 0 1 20 7.5 L20 16.5 A4 4 0 0 1 16 20.5 L8 20.5 A4 4 0 0 1 4 16.5 L4 7.5 A4 4 0 0 1 8 3.5 Z M12 3.5 L12 10"; }
        return "M4 12 L20 12";
    }

    // Filled icons (play, bolt, dots) need a fill instead of a stroke.
    public pure function is-filled(kind: IconKind) -> bool {
        return kind == IconKind.play || kind == IconKind.bolt || kind == IconKind.star;
    }
}

// A single stroke/fill icon. Original geometry from the Icons global.
export component Icon inherits Rectangle {
    in property <IconKind> kind: IconKind.info;
    in property <color> tint: Tokens.text;
    in property <length> size: 16px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    in property <length> stroke: 1.6px;
    width: size;
    height: size;
    background: transparent;

    icon-path := Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.commands(root.kind);
        stroke: Icons.is-filled(root.kind) ? transparent : root.tint;
        stroke-width: Icons.is-filled(root.kind) ? 0 : root.stroke;
        fill: Icons.is-filled(root.kind) ? root.tint : transparent;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Glass panel per D1 section 4. `tier` degrades from full glass to a solid
// tinted panel when the compositor cannot blur or reduce-transparency is on.
export component GlassPanel inherits Rectangle {
    in property <GlassTier> tier: GlassTier.full;
    in property <length> radius: Tokens.radius-panel;
    in property <color> tint: Tokens.surface;
    in property <length> pad: Tokens.space(3);
    in property <bool> floating: true;

    background: root.tint.with-alpha(Tokens.tier-opacity(root.tier));
    border-radius: radius;
    border-width: 1px;
    border-color: root.tier == GlassTier.minimal ? Tokens.glass-edge-minimal : Tokens.glass-edge;
    drop-shadow-blur: root.tier == GlassTier.minimal ? 4px : (root.tier == GlassTier.reduced ? 8px : 24px);
    drop-shadow-color: #00000033;
    drop-shadow-offset-y: 4px;
    if root.floating : Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: @linear-gradient(180deg, #FFFFFF14 0%, #FFFFFF00 60%);
        border-radius: root.radius;
    }
    content := Rectangle {
        x: root.pad; y: root.pad;
        width: parent.width - root.pad * 2;
        height: parent.height - root.pad * 2;
        background: transparent;
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Tokens.divider;
}

export component AetherButton inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <IconKind> icon: IconKind.info;
    in property <bool> show-icon: false;
    callback clicked();

    height: 32px;
    min-width: 72px;
    border-radius: Tokens.radius-button;
    background: !enabled ? Tokens.surface-high.with-alpha(0.5)
        : primary ? (ta.pressed ? Tokens.accent-strong : (ta.has-hover ? Tokens.accent-strong : Tokens.accent))
        : (ta.pressed ? Tokens.pressed : (ta.has-hover ? Tokens.hover : Tokens.surface-high));
    border-width: primary ? 0px : 1px;
    border-color: Tokens.divider;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.show-icon : Icon {
            kind: root.icon;
            size: 14px;
            tint: root.primary ? Tokens.on-accent : Tokens.text;
        }
        Text {
            text: root.text;
            color: !root.enabled ? Tokens.text-faint : (root.primary ? Tokens.on-accent : Tokens.text);
            font-size: Tokens.font-body;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    animate background { duration: Tokens.motion-fast; }
}

export component IconButton inherits Rectangle {
    in property <IconKind> kind: IconKind.info;
    in property <string> label: "";
    in property <bool> toggled: false;
    in property <bool> enabled: true;
    in property <length> button-size: 24px;
    in property <length> icon-size: 15px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: Tokens.radius-button;
    background: ta.pressed ? Tokens.pressed : (root.toggled ? Tokens.accent-soft : (ta.has-hover ? Tokens.hover : transparent));
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    Icon {
        kind: root.kind;
        size: root.icon-size;
        tint: !root.enabled ? Tokens.text-faint : (root.toggled ? Tokens.accent-strong : Tokens.text-muted);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> label: "";
    callback toggled(bool);

    height: 20px;
    width: 36px;
    border-radius: Tokens.radius-pill;
    background: !enabled ? Tokens.surface-high.with-alpha(0.4)
        : checked ? Tokens.accent : Tokens.surface-high;
    border-width: 1px;
    border-color: checked ? transparent : Tokens.divider;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;

    handle := Rectangle {
        width: 16px;
        height: 16px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: Tokens.radius-pill;
        background: root.checked ? Tokens.text : Tokens.text-muted;
        animate x { duration: Tokens.motion-base; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component AetherSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <string> label: "";
    in property <bool> enabled: true;
    callback changed(float);

    height: 20px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value * 100;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 1;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: parent.width;
        border-radius: Tokens.radius-pill;
        background: Tokens.surface-high;
    }
    fill := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: parent.width * root.value;
        border-radius: Tokens.radius-pill;
        background: root.enabled ? Tokens.accent : Tokens.text-faint;
    }
    Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        border-radius: Tokens.radius-pill;
        background: Tokens.text;
        border-width: 1px;
        border-color: #00000033;
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                root.value = Math.max(0, Math.min(1, self.mouse-x / self.width));
                root.changed(root.value);
            }
        }
    }
}

export component SegmentedControl inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> current: 0;
    callback selected(int);

    height: 28px;
    background: Tokens.surface-low;
    border-radius: Tokens.radius-button;
    border-width: 1px;
    border-color: Tokens.divider;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[idx] in root.items : Rectangle {
            border-radius: 6px;
            background: root.current == idx ? Tokens.surface-high : transparent;
            horizontal-stretch: 1;
            accessible-role: tab;
            accessible-label: item;
            accessible-checked: root.current == idx;
            ta := TouchArea {
                clicked => {
                    root.current = idx;
                    root.selected(idx);
                }
            }
            Text {
                text: item;
                color: root.current == idx ? Tokens.text : Tokens.text-muted;
                font-size: Tokens.font-small;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback accepted();

    height: 40px;
    background: Tokens.surface-low;
    border-radius: Tokens.radius-button;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.accent : Tokens.divider;
    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-value: root.text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Icon {
            kind: IconKind.search;
            size: 15px;
            tint: Tokens.text-faint;
        }
        input := TextInput {
            accessible-role: none;
            color: Tokens.text;
            font-size: Tokens.font-body;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <IconKind> icon: IconKind.file;
    in property <bool> show-icon: false;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: Tokens.radius-button;
    background: root.selected ? Tokens.accent-soft : (ta.has-hover ? Tokens.hover : transparent);
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-checked: root.selected;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.show-icon : Icon {
            kind: root.icon;
            size: 15px;
            tint: root.selected ? Tokens.accent-strong : Tokens.text-muted;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: Tokens.text;
                font-size: Tokens.font-body;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Tokens.text-muted;
                font-size: Tokens.font-small;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Badge inherits Rectangle {
    in property <string> count: "";
    width: Math.max(16px, label.preferred-width + 8px);
    height: 16px;
    border-radius: Tokens.radius-pill;
    background: Tokens.danger;
    label := Text {
        text: root.count;
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Pill inherits Rectangle {
    in property <string> text: "";
    in property <color> tone: Tokens.text-muted;
    height: 20px;
    width: pill-label.preferred-width + 16px;
    border-radius: Tokens.radius-pill;
    background: root.tone.with-alpha(0.16);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.35);
    pill-label := Text {
        text: root.text;
        color: root.tone;
        font-size: Tokens.font-small;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SectionLabel inherits Text {
    in property <string> label: "";
    text: root.label;
    color: Tokens.text-faint;
    font-size: Tokens.font-small;
    font-weight: 700;
    letter-spacing: 0.6px;
    horizontal-stretch: 0;
}

export component MenuItem inherits Rectangle {
    in property <string> text: "";
    in property <string> shortcut: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? Tokens.accent : transparent;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;
        Text {
            text: root.text;
            color: !root.enabled ? Tokens.text-faint : (ta.has-hover ? Tokens.on-accent : Tokens.text);
            font-size: Tokens.font-body;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.shortcut;
        color: ta.has-hover ? Tokens.on-accent.with-alpha(0.7) : Tokens.text-faint;
        font-size: Tokens.font-small;
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Visual smoke-test surface for the design system (P4 evidence + CI render).
// This is the component the Rust bindings expose, because Slint only generates
// Rust code for Window components by default; every other export is consumed
// from .slint files by the shell and the apps.
export component DesignGallery inherits Window {
    title: "AetherOS design system";
    width: 960px;
    height: 620px;
    background: Tokens.background;

    VerticalLayout {
        padding: Tokens.space(6);
        spacing: Tokens.space(4);

        HorizontalLayout {
            spacing: Tokens.space(3);
            Text {
                text: "AetherOS";
                color: Tokens.text;
                font-size: Tokens.font-hero;
                font-weight: 700;
            }
            Text {
                text: "design system · dark glass · 4 px grid";
                color: Tokens.text-muted;
                font-size: Tokens.font-body;
                vertical-alignment: center;
            }
        }

        // Typography and tones.
        HorizontalLayout {
            spacing: Tokens.space(4);
            VerticalLayout {
                spacing: Tokens.space(1);
                Text { text: "Primary"; color: Tokens.text; font-size: Tokens.font-title; font-weight: 600; }
                Text { text: "Body copy — calm, quiet chrome."; color: Tokens.text-muted; font-size: Tokens.font-body; }
                Text { text: "Small meta 11 px"; color: Tokens.text-faint; font-size: Tokens.font-small; }
            }
            VerticalLayout {
                spacing: Tokens.space(1);
                SectionLabel { label: "TONES"; }
                HorizontalLayout {
                    spacing: Tokens.space(2);
                    Pill { text: "+ 128 MB"; tone: Tokens.success; }
                    Pill { text: "- 40 MB"; tone: Tokens.danger; }
                    Pill { text: "Needs firmware"; tone: Tokens.warning; }
                    Pill { text: "Working"; tone: Tokens.accent; }
                }
            }
        }

        // Controls.
        GlassPanel {
            height: 200px;
            pad: Tokens.space(4);
            HorizontalLayout {
                spacing: Tokens.space(5);
                VerticalLayout {
                    spacing: Tokens.space(2);
                    alignment: start;
                    AetherButton { text: "Primary"; primary: true; }
                    AetherButton { text: "Secondary"; }
                    AetherButton { text: "Disabled"; enabled: false; }
                    AetherButton { text: "With icon"; icon: IconKind.download; show-icon: true; }
                }
                VerticalLayout {
                    spacing: Tokens.space(3);
                    HorizontalLayout {
                        spacing: Tokens.space(2);
                        Text { text: "Wi-Fi"; color: Tokens.text; vertical-alignment: center; }
                        ToggleSwitch { checked: true; label: "Wi-Fi"; }
                    }
                    HorizontalLayout {
                        spacing: Tokens.space(2);
                        Text { text: "Bluetooth"; color: Tokens.text; vertical-alignment: center; }
                        ToggleSwitch { checked: false; label: "Bluetooth"; }
                    }
                    AetherSlider { value: 0.62; label: "Volume"; }
                    SegmentedControl { items: ["24-hour", "12-hour"]; current: 0; }
                    SearchField { placeholder: "Search apps, files and settings"; }
                }
                VerticalLayout {
                    spacing: Tokens.space(1);
                    SectionLabel { label: "ICONS"; }
                    HorizontalLayout {
                        for kind in [
                            IconKind.menu, IconKind.search, IconKind.wifi, IconKind.bluetooth,
                            IconKind.volume, IconKind.brightness, IconKind.battery, IconKind.bell,
                            IconKind.moon, IconKind.gear, IconKind.folder, IconKind.image,
                        ] : Icon { kind: kind; size: 18px; tint: Tokens.text-muted; }
                    }
                    HorizontalLayout {
                        for kind in [
                            IconKind.document, IconKind.terminal, IconKind.calendar, IconKind.clock,
                            IconKind.play, IconKind.lock, IconKind.user, IconKind.power,
                            IconKind.trash, IconKind.download, IconKind.star, IconKind.info,
                        ] : Icon { kind: kind; size: 18px; tint: Tokens.text-muted; }
                    }
                }
            }
        }

        // Rows and menu items.
        HorizontalLayout {
            spacing: Tokens.space(4);
            VerticalLayout {
                spacing: 2px;
                SectionLabel { label: "LIST"; }
                ListRow { title: "AetherPad"; subtitle: "Text · edited 2 minutes ago"; show-icon: true; icon: IconKind.file; selected: true; }
                ListRow { title: "Notes.md"; subtitle: "/home/anik/Documents"; show-icon: true; icon: IconKind.file; }
                ListRow { title: "Photos"; subtitle: "48 items · /home/anik/Pictures"; show-icon: true; icon: IconKind.folder; }
            }
            VerticalLayout {
                spacing: 2px;
                SectionLabel { label: "MENU"; }
                Rectangle {
                    background: Tokens.surface; border-radius: Tokens.radius-menu; border-width: 1px; border-color: Tokens.divider;
                    width: 240px; height: 132px;
                    VerticalLayout {
                        padding: 4px;
                        MenuItem { text: "New window"; shortcut: "⌘N"; }
                        MenuItem { text: "Open…"; shortcut: "⌘O"; }
                        MenuItem { text: "Save"; shortcut: "⌘S"; }
                        MenuItem { text: "Close"; shortcut: "⌘W"; enabled: false; }
                    }
                }
            }
        }
    }
}
