# Buildroot configuration for AetherOS (P1-T01).
#
# Use: from os-build/buildroot/, run
#   make BR2_DEFCONFIG=aetheros_defconfig defconfig
#   make
# (Buildroot must run on Linux — see README.md; the kernel-config CI job
# validates the kernel fragment on every push.)

# --- Architecture: x86-64 only (ADR-016) ---
BR2_x86_64=y

# --- Toolchain: glibc (systemd and NetworkManager require glibc; uclibc
# silently drops them) and headers pinned to our kernel ---
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# 2025.11: BR2_KERNEL_HEADERS_AS_KERNEL only selects BR2_KERNEL_HEADERS_LATEST
# when BR2_LINUX_KERNEL_LATEST_VERSION is set, which we do not use (custom
# 6.18). Select the matching series explicitly instead.
BR2_KERNEL_HEADERS_6_18=y
# C++ (libstdc++) is required by Mesa3d in 2025.11: BR2_PACKAGE_MESA3D has
# `depends on BR2_INSTALL_LIBSTDCPP`, and only BR2_TOOLCHAIN_BUILDROOT_CXX
# selects it. Without this line every Mesa symbol below is dropped silently by
# olddefconfig and the image ships no EGL/GBM at all (seen in P2: glxinfo was
# missing from the image).
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- Kernel: mainline LTS with our fragment (ADR-001) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
# Layout: the Buildroot tree is cloned at os-build/buildroot/buildroot/,
# so ../../kernel/ is os-build/kernel/. The CI job passes the same paths.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="../../kernel/aether.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- Init: systemd minimal profile (ADR-003; P1-T02 compares runit/s6) ---
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y
# Minimal profile: trim services we do not use.
# BR2_PACKAGE_SYSTEMD_JOURNALGATEWAYD is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# The console getty moves to tty2 (2026-11-28, UI image): tty1 belongs to the
# DRM compositor started by aether-session.service. tty2 keeps a text login
# (and therefore `test.sh`) if the graphical start fails; sshd is unaffected.
BR2_TARGET_GENERIC_GETTY_PORT="tty2"

# --- Filesystem image: read-only squashfs root (P1-T03, D4) ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set
# Rootfs overlay: tmpfs /var and /home over the read-only root (P1-T03)
BR2_ROOTFS_OVERLAY="../../board/aetheros/overlay"

# --- UEFI boot chain: systemd-boot + UKI (P1-T05, D4 §3) ---
BR2_PACKAGE_SYSTEMD_BOOT=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="../../board/aetheros/post-image.sh"
# Runs before the filesystem images are made: builds the Rust workspace
# binaries on the build host and installs them into $TARGET_DIR/usr/bin
# (see os-build/post-build.sh and os-build/buildroot/ui/README.md).
BR2_ROOTFS_POST_BUILD_SCRIPT="../../post-build.sh"

# --- Legacy BIOS boot chain: GRUB2 for MBR disks (P1-T07, D4 §3) ---
# grub-install runs as a CI step (needs a loop device); see
# board/aetheros/make-bios-image.sh.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y

# --- Userspace bases: filesystem tools ---
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_BTRFS_PROGS=y

# --- Networking (P1-T04; systemd-networkd with DHCP) ---
# NetworkManager requires D-Bus which is not enabled; use systemd-networkd
# (already built by BR2_PACKAGE_SYSTEMD) with a DHCP .network unit in the
# rootfs overlay.
BR2_PACKAGE_SYSTEMD_NETWORKD=y

# --- Battery and power data sources (D5, ADR-014) ---
BR2_PACKAGE_UPOWER=y
BR2_PACKAGE_POWER_PROFILES_DAEMON=y

# --- P2 additions (hardware bring-up) — merged 2026-11-23 (P1 green) ---
# Graphics (P2-T02): Mesa + Vulkan (ANV, RADV) for Intel/AMD
BR2_PACKAGE_MESA3D=y
# 2025.11: iris/radeonsi/ANV/RADV all depend on BR2_PACKAGE_MESA3D_LLVM (the
# target LLVM build). They stay listed for reference but are inactive until the
# owner accepts the cost: LLVM adds roughly half an hour to the image build and
# pushes the compressed image well past the 150 MB P1 gate.
# Hardware EGL on the Dell's Iris Xe needs BR2_PACKAGE_MESA3D_LLVM=y plus
# BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y (see the 2026-11-28 D6 note).
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
# UI image (2026-11-28): the compositor's DRM backend needs EGL + GLES + GBM.
# softpipe is the only gallium driver Buildroot 2025.11 offers without LLVM, so
# it is what actually ships tonight: EGL_PLATFORM_GBM -> kms_swrast over the
# i915/amdgpu KMS plane. Slow, but it renders and keeps the image small.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
# XWayland for X11 apps (P3-T03)
BR2_PACKAGE_XWAYLAND=y

# Audio (P2-T04): PipeWire + WirePlumber + ALSA tools
BR2_PACKAGE_PIPEWIRE=y
# WirePlumber is the PipeWire session/policy manager and needs Lua >= 5.3
# (package/wireplumber/Config.in). The chain is three symbols deep:
#
#   BR2_PACKAGE_WIREPLUMBER -> BR2_PACKAGE_HAS_LUA_INTERPRETER
#     -> BR2_PACKAGE_LUA_5_4 ... and the version choice lives *inside*
#     `if BR2_PACKAGE_LUA` in package/lua/Config.in, so BR2_PACKAGE_LUA=y is
#     required for BR2_PACKAGE_LUA_5_4 to exist at all.
#
# Both halves of the Lua selection are therefore listed. Without
# BR2_PACKAGE_LUA the version line is dropped by olddefconfig, WirePlumber's
# dependency is unsatisfied, and the image ships PipeWire with no session
# manager - seen on the Dell in P2 run 3 and again in image build 46041689625
# (`Build wireplumber : NO`, commit dabbb76, which already had the version
# line). os-build/scripts/check-ui-image.sh guards this class: a child symbol
# without its package, or a defconfig =y symbol missing from the generated
# .config, fails the check.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_BAT=y
# Regulatory database for cfg80211/ath10k
BR2_PACKAGE_WIRELESS_REGDB=y

# Firmware subset (P2-T01): display + audio + Wi-Fi/BT for the Dell
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174A_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_AR3012_USB=y

# Wi-Fi tools (P2-T03)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_IW=y

# Bluetooth (P2-T03)
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y

# Input (P2-T05)
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_UDEV=y

# --- Graphical session runtime (UI image, 2026-11-28) ---
# Slint renders text through fontdb/fontconfig: without these the shell and
# every app exit at startup with "no fonts available".
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_DEJAVU=y
# Keyboard: the compositor compiles its keymap with xkbcommon (dlopen) and the
# data files xkeyboard-config installs under /usr/share/X11/xkb.
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
# Seat: smithay's backend_session_libseat opens /dev/dri/card0 and the evdev
# nodes through libseat. The session unit runs as a root system service with no
# logind session, so libseat uses its builtin backend (LIBSEAT_BACKEND=builtin
# in board/aetheros/overlay/usr/bin/aether-session); no seatd daemon is needed.
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_BUILTIN=y
# aether-compositor / aether-shell / aether-greeter and the apps themselves are
# built by BR2_ROOTFS_POST_BUILD_SCRIPT (os-build/post-build.sh) because the
# workspace also needs the `drm` cargo feature; the binary list lives in
# os-build/buildroot/ui/binaries.txt.

# Validation tools (P2): lspci/lsusb/glxinfo/vulkaninfo
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
# P2 run 3: `lsusb` printed "unable to initialize usb spec" because the image
# carried no /usr/share/hwdata/usb.ids. hwdata installs it where usbutils looks.
BR2_PACKAGE_HWDATA=y
BR2_PACKAGE_HWDATA_USB_IDS=y
# Boot switching (2026-11-28): aether-boot-return.service sets the next UEFI
# boot entry back to Ubuntu with `efibootmgr -n`. 2025.11 dependencies are all
# satisfied here: EFIVAR_ARCH_SUPPORTS (x86_64), !BR2_STATIC_LIBS (glibc
# toolchain), threads, headers >= 3.12 (6.18), gcc >= 4.9; efivar and popt are
# selected by the package.
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_MESA3D_DEMOS=y
BR2_PACKAGE_VULKAN_TOOLS=y

# SSH server for autonomous hardware validation (P2)
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
