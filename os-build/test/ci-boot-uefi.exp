#!/usr/bin/expect -f
# P1-T05: UEFI boot test — boots aetheros-efi.img through OVMF.
# Uses the EFI shell to manually boot the kernel, since systemd-boot/GRUB
# don't produce serial output in this environment.
# Env: DISK (aetheros-efi.img), OVMF (OVMF_CODE.fd), TRANSCRIPT.
# Marker: S_UEFI_BOOT_"OK"

set timeout 300
set t0 [clock seconds]
log_file -noappend $env(TRANSCRIPT)

spawn qemu-system-x86_64 -m 512 -nographic -no-reboot \
  -drive if=pflash,format=raw,readonly=on,file=$env(OVMF) \
  -drive if=pflash,format=raw,file=$env(OVMF_VARS) \
  -drive file=$env(DISK),format=raw,if=virtio

# Wait for EFI shell
expect {
    "Shell>" { }
    timeout { puts "TIMEOUT waiting for EFI shell"; exit 2 }
}
# Boot the kernel directly via EFI
send "FS0:\\bzImage root=/dev/vda2 rootfstype=squashfs console=ttyS0 net.ifnames=0 biosdevname=0\r"
expect {
    -re "login:" { }
    timeout { puts "TIMEOUT waiting for login prompt (UEFI chain)"; exit 2 }
}
puts "S_UEFI_SECONDS: [expr [clock seconds] - $t0]"
send "root\r"
expect "# "
send {echo S_UEFI_BOOT_"OK"; poweroff}
send "\r"
expect eof