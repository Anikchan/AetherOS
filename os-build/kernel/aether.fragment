# aether.fragment — AetherOS kernel configuration fragment (P1-T01).
#
# Merged on top of the x86_64 defconfig by Buildroot
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES) and validated by the
# kernel-config CI job (.github/workflows/kernel-config.yml).
#
# Source: roadmap P1-T01, design D4, spike S3 finding (PSI must be built in).

# --- Process management (D3): cgroups v2, freezer, memcg, PSI ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
# Spike S3 (docs/2026/11/18/results/p0-t09-spike-s3.md): PSI must be built in;
# the Alpine virt kernel lacks it. Pressure-driven killer depends on it.
CONFIG_PSI=y

# --- Memory: zram compressed swap ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSWAP=y

# --- Filesystems: read-only squashfs root, ext4, Btrfs ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y

# --- Boot: UEFI with EFI stub (UKI, P1-T05); legacy BIOS via GRUB (P1-T07) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- Graphics: kernel mode setting for Intel and AMD (P2-T02) ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_FB=y

# --- Power: tickless idle, runtime power management, suspend (F7, D5) ---
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y

# --- Virtualization: virtio for the Linux test VMs (ADR-017) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y

# --- Android container (P6-AND, D9): binder IPC on the host kernel ---
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ---------------------------------------------------------------------------
# P2 additions (hardware bring-up) — additive; do not remove any P1 option.
# These are required for P2-T03 (Wi-Fi/BT), P2-T04 (audio), P2-T05 (input),
# P2-T06 (sleep/resume). Validated once the kernel-config CI job runs again.
# ---------------------------------------------------------------------------

# --- Sound (P2-T04): ALSA core + common codecs/HDA/USB ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y

# --- Wireless (P2-T03): cfg80211/mac80211 + common drivers ---
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLWIFI=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y

# --- Bluetooth (P2-T03) ---
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y

# --- Input (P2-T05): HID, touchpad, backlight ---
CONFIG_INPUT=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y

# --- Sleep and resume (P2-T06) ---
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI_SLEEP=y
CONFIG_ACPI=y
