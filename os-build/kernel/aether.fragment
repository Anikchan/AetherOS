# aether.fragment — AetherOS kernel configuration fragment (P1-T01).
#
# Merged on top of the x86_64 defconfig by Buildroot
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES) and validated by the
# kernel-config CI job (.github/workflows/kernel-config.yml).
#
# Source: roadmap P1-T01, design D4, spike S3 finding (PSI must be built in).

# --- Process management (D3): cgroups v2, freezer, memcg, PSI ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
# Spike S3 (docs/2026/11/18/results/p0-t09-spike-s3.md): PSI must be built in;
# the Alpine virt kernel lacks it. Pressure-driven killer depends on it.
CONFIG_PSI=y

# --- Memory: zram compressed swap ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSWAP=y

# --- Filesystems: read-only squashfs root, ext4, Btrfs ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y

# --- Boot: UEFI with EFI stub (UKI, P1-T05); legacy BIOS via GRUB (P1-T07) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
# Serial console (needed for UEFI boot output on OVMF/real hardware)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Fallback command line for UEFI (systemd-boot may not pass options correctly).
# Not forced: the bootloader's -append/cmdline takes precedence when present
# (direct BIOS boot uses root=/dev/vda via -append).
CONFIG_CMDLINE="root=PARTUUID=9f8e7d6c-1a2b-4c3d-8e4f-5a6b7c8d9e0f rootfstype=squashfs rootwait console=tty0 console=ttyS0,115200n8 earlycon=efi net.ifnames=0 biosdevname=0"
# CONFIG_CMDLINE_FORCE is not set

# --- Graphics: kernel mode setting for Intel and AMD (P2-T02) ---
CONFIG_DRM=y
# i915 as a module so udev loads it after the rootfs is mounted; the DMC/GuC/HuC
# firmware then loads from /lib/firmware and runtime power management works.
# simpledrm (built-in) drives the display until i915 takes over.
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=y
CONFIG_FB=y
# Virtual terminal + framebuffer console (needed for bare-metal display output)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# Early console via EFI framebuffer (shows boot messages before i915 loads)
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
# Note: i915 DMC firmware is loaded from rootfs (/lib/firmware) at runtime.
# For early console before i915 loads, simpledrm (EFI framebuffer) is used.

# --- Power: tickless idle, runtime power management, suspend (F7, D5) ---
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y

# --- Virtualization: virtio for the Linux test VMs (ADR-017) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y

# --- USB storage: needed to boot from a USB stick on bare metal ---
# Built-in (not modules) because there is no initramfs to load modules
# before the root filesystem is mounted. rootwait in the cmdline handles
# USB enumeration delay.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# USB Ethernet (Realtek RTL8152/8153) for SSH during hardware validation
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y

# --- Android container (P6-AND, D9): binder IPC on the host kernel ---
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ---------------------------------------------------------------------------
# P2 additions (hardware bring-up) — additive; do not remove any P1 option.
# These are required for P2-T03 (Wi-Fi/BT), P2-T04 (audio), P2-T05 (input),
# P2-T06 (sleep/resume). Validated once the kernel-config CI job runs again.
# ---------------------------------------------------------------------------

# --- Sound (P2-T04): ALSA core + common codecs/HDA/USB ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y

# --- Wireless (P2-T03): cfg80211/mac80211 + common drivers ---
# P2 hardware run 3 (docs/2026/11/27/results/p2-hardware-validation-run3.md):
# with cfg80211 built in, reg.c's regulatory_init_db() runs from a
# late_initcall (net/wireless/reg.c: late_initcall(regulatory_init_db)), i.e.
# before the squashfs root is mounted, so request_firmware("regulatory.db")
# returns -ENOENT ("Direct firmware load for regulatory.db failed with error
# -2") and the regdomain stays world ("country 00", passive scan).
# As a module the same code runs from regulatory_init() at module load
# (#ifdef MODULE branch) - after systemd-udev is up and /lib/firmware is
# readable - and MODULE_FIRMWARE("regulatory.db") lets depmod/udev order it.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
# iwlwifi depends on CFG80211, so it must follow it to the module side.
CONFIG_IWLWIFI=m
# ath10k must be a module so udev loads it after the rootfs is mounted;
# as a built-in it probes before rootfs and cannot read the firmware.
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m

# --- Bluetooth (P2-T03) ---
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y

# --- Input (P2-T05): HID, touchpad, backlight ---
CONFIG_INPUT=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y
# Touchpad: I2C HID (Dell Inspiron touchpad) + I2C designware platform
CONFIG_I2C=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# P2 run 3: the touchpad (`\_SB.PC00.I2C1.TPD0`, HID DLL09D9 / PNP0C50, on PCI
# 00:15.1) enumerated as an i2c client but i2c-hid refused it with
# "HID over i2c has not been provided an Int IRQ" (-EINVAL): there was no
# gpiochip in the whole system, so the ACPI GpioInt behind the touchpad IRQ
# could not be resolved (i2c-core-base.c resolves it at probe time and collapses
# non-defer errors to client->irq = 0; i2c-hid-core.c then rejects the device).
# INT34C5 is ACPI `\_SB.GPI0` on this machine and is handled by
# pinctrl-tigerlake (PINCTRL_INTEL, GPIOLIB, GPIOLIB_IRQCHIP are selected).
# PINCTRL is a menuconfig that the x86_64 defconfig leaves off, and without it
# no pin/GPIO controller driver is even visible to Kconfig.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_TIGERLAKE=y
# i2c-hid as modules so the probe happens after the built-in GPIO/pinctrl
# controllers are registered. Driver: i2c-hid-acpi (04F3:3147 -> hid-multitouch).
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
# Webcam: USB Video Class
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# --- Sleep and resume (P2-T06) ---
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI_SLEEP=y
CONFIG_ACPI=y
